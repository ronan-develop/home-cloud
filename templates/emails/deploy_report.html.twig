{% extends 'emails/_layout.html.twig' %}

{% block title %}Déploiement nocturne — HomeCloud{% endblock %}

{% set maxWidth = 560 %}

{% block content %}
{% set failedResults = results|filter(r => r.status == 'failed') %}
{% set criticalResults = results|filter(r => r.status == 'critical') %}
{% set okCount = results|filter(r => r.status == 'ok')|length %}
{% set failedCount = failedResults|length %}
{% set criticalCount = criticalResults|length %}
{% set skippedCount = results|filter(r => r.status == 'skipped')|length %}
{% set postponedCount = results|filter(r => r.status == 'postponed')|length %}

<tr>
<td style="padding:20px 32px 4px 32px; color:#0b1220; font-size:17px; font-weight:600; line-height:1.4;">
Déploiement nocturne — {{ "now"|date("d/m/Y") }}
</td>
</tr>
<tr>
<td style="padding:0 32px 20px 32px; color:#5b6472; font-size:14px; line-height:1.5;">
{% if okCount > 0 %}<span style="color:#1a9d5c; font-weight:600;">{{ okCount }} déployée{{ okCount > 1 ? 's' : '' }}</span>{% endif %}
{% if criticalCount > 0 %} · <span style="color:#943126; font-weight:700;">{{ criticalCount }} critique{{ criticalCount > 1 ? 's' : '' }}</span>{% endif %}
{% if failedCount > 0 %} · <span style="color:#c0392b; font-weight:600;">{{ failedCount }} échec{{ failedCount > 1 ? 's' : '' }}</span>{% endif %}
{% if postponedCount > 0 %} · <span style="color:#b8860b; font-weight:600;">{{ postponedCount }} reportée{{ postponedCount > 1 ? 's' : '' }}</span>{% endif %}
{% if skippedCount > 0 %} · <span style="color:#8a8f98;">{{ skippedCount }} déjà à jour</span>{% endif %}
</td>
</tr>

{% if criticalCount > 0 %}
<tr>
<td style="padding:0 32px 20px 32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#943126; border-radius:8px;">
{% for r in criticalResults %}
<tr>
<td style="padding:12px 16px; color:#fff; font-size:13px; line-height:1.5;">
🚨 <strong>{{ r.instance }}</strong> a échoué à l'étape <strong>{{ r.step }}</strong> — erreur d'environnement (commande introuvable). <strong>Un nouvel essai automatique échouera identiquement chaque nuit : intervention manuelle requise.</strong>
</td>
</tr>
{% endfor %}
</table>
</td>
</tr>
{% endif %}

{% if failedCount > 0 %}
<tr>
<td style="padding:0 32px 20px 32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FDEDEC; border:1px solid #F5C6C0; border-radius:8px;">
{% for r in failedResults %}
<tr>
<td style="padding:12px 16px; color:#943126; font-size:13px; line-height:1.5;">
⚠️ <strong>{{ r.instance }}</strong> a échoué à l'étape <strong>{{ r.step }}</strong>{% if r.sha %} (SHA <code style="background:#fff; padding:1px 5px; border-radius:4px;">{{ r.sha }}</code>){% endif %}. Nouvelle tentative automatique la nuit prochaine — aucune action requise.
</td>
</tr>
{% endfor %}
</table>
</td>
</tr>
{% endif %}

{% if postponedCount > 0 %}
<tr>
<td style="padding:0 32px 20px 32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FBF3DB; border:1px solid #EFD98A; border-radius:8px;">
<tr>
<td style="padding:12px 16px; color:#8a6d1e; font-size:13px; line-height:1.5;">
🌙 {{ postponedCount }} instance{{ postponedCount > 1 ? 's' : '' }} reportée{{ postponedCount > 1 ? 's' : '' }} — activité utilisateur détectée, nouvelle tentative automatique la nuit prochaine.
</td>
</tr>
</table>
</td>
</tr>
{% endif %}

<tr>
<td style="padding:0 32px 8px 32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:13px; color:#0b1220; border-collapse:collapse;">
<tr>
<td style="padding:8px 8px; font-weight:600; color:#8a8f98; text-transform:uppercase; font-size:11px; letter-spacing:0.03em; border-bottom:2px solid #eee;">Instance</td>
<td style="padding:8px 8px; font-weight:600; color:#8a8f98; text-transform:uppercase; font-size:11px; letter-spacing:0.03em; border-bottom:2px solid #eee;">Statut</td>
<td style="padding:8px 8px; font-weight:600; color:#8a8f98; text-transform:uppercase; font-size:11px; letter-spacing:0.03em; border-bottom:2px solid #eee;">Détail</td>
</tr>
{% for r in results %}
<tr>
<td style="padding:10px 8px; border-bottom:1px solid #f2f2f2; font-weight:500;">{{ r.instance }}</td>
<td style="padding:10px 8px; border-bottom:1px solid #f2f2f2;">
{% if r.status == 'ok' %}
<span style="display:inline-block; padding:2px 9px; border-radius:99px; background:#E9F9F0; color:#1a9d5c; font-size:12px; font-weight:600;">✅ déployé</span>
{% elseif r.status == 'critical' %}
<span style="display:inline-block; padding:2px 9px; border-radius:99px; background:#943126; color:#fff; font-size:12px; font-weight:700;">🚨 critique</span>
{% elseif r.status == 'failed' %}
<span style="display:inline-block; padding:2px 9px; border-radius:99px; background:#FDEDEC; color:#c0392b; font-size:12px; font-weight:600;">❌ échec</span>
{% elseif r.status == 'postponed' %}
<span style="display:inline-block; padding:2px 9px; border-radius:99px; background:#FBF3DB; color:#8a6d1e; font-size:12px; font-weight:600;">🌙 reporté</span>
{% else %}
<span style="display:inline-block; padding:2px 9px; border-radius:99px; background:#F1F2F4; color:#5b6472; font-size:12px; font-weight:600;">⏭️ à jour</span>
{% endif %}
</td>
<td style="padding:10px 8px; border-bottom:1px solid #f2f2f2; color:{{ r.status in ['failed', 'critical'] ? '#943126' : '#8a8f98' }}; font-size:12px;{% if r.status not in ['failed', 'critical'] %} font-family:ui-monospace,SFMono-Regular,Menlo,monospace;{% endif %}">
{% if r.status in ['failed', 'critical'] %}étape « {{ r.step }} »
{% elseif r.sha is not empty %}{{ r.sha }}
{% else %}—
{% endif %}
</td>
</tr>
{% endfor %}
</table>
</td>
</tr>
{% endblock %}

{% block footerNote %}
{% if criticalCount > 0 %}Les instances en échec critique nécessitent une intervention manuelle — elles ne se corrigeront pas seules. {% endif %}Les autres instances en échec seront retentées automatiquement la nuit prochaine, sans action de votre part.
{% endblock %}
