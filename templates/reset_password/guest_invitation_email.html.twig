{% extends 'emails/_layout.html.twig' %}

{% block title %}Invitation HomeCloud{% endblock %}

{% block content %}
<tr>
<td style="padding:24px 32px 8px 32px; color:#0b1220; font-size:15px; line-height:1.5;">
Bonjour,
</td>
</tr>
<tr>
<td style="padding:0 32px 24px 32px; color:#0b1220; font-size:15px; line-height:1.5;">
{% if ownerName %}<strong>{{ ownerName }}</strong> vient de partager une ressource avec vous sur son stockage personnalisé HomeCloud.{% else %}Quelqu'un vient de partager une ressource avec vous sur son stockage personnalisé HomeCloud.{% endif %} Un compte a été créé pour vous.
</td>
</tr>
<tr>
<td align="center" style="padding:0 32px 32px 32px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
<tr>
<td align="center" bgcolor="{{ accentColor }}" style="border-radius:8px;">
<a href="{{ activationUrl }}" style="display:inline-block; padding:12px 28px; font-size:15px; font-weight:bold; color:#FFFFFF; text-decoration:none; border-radius:8px;">
Définir mon mot de passe
</a>
</td>
</tr>
</table>
</td>
</tr>
{% endblock %}

{% block footerNote %}
Si vous ne vous attendiez pas à cette invitation, vous pouvez ignorer cet email.
<br>
Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur&nbsp;: {{ activationUrl }}
{% endblock %}
