{% extends 'web/layout.html.twig' %}

{% block title %}Import Google Photos — HomeCloud{% endblock %}

{% block content %}

<div class="max-w-2xl mx-auto flex flex-col gap-6" data-controller="takeout-import">

    <div>
        <h1 class="text-2xl font-bold" style="color: var(--hc-text)">Import Google Photos</h1>
        <p style="color: var(--hc-text-secondary, var(--hc-text))">
            Importez votre export Google Photos Takeout (un ou plusieurs fichiers ZIP).
            Les photos sont rangées dans un dossier dédié, les métadonnées (date, position)
            sont conservées, et les doublons déjà importés sont automatiquement ignorés.
        </p>
        <!-- #493 : un import interrompu (fermeture d'onglet en cours d'envoi,
             #481) reste repris automatiquement tant qu'il n'a pas dépassé
             TakeoutImport::PURGE_AFTER_DAYS — au-delà, il est purgé
             automatiquement et un nouvel import repart de 0, sans erreur
             visible (comportement transparent mais qui pourrait surprendre
             sans cette mention). -->
        <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))">
            Un import interrompu peut être repris dans les 7 jours suivant sa dernière tentative.
        </p>
        <!-- #505 : une mise en veille du PC pendant l'envoi coupe la
             connexion (constaté en conditions réelles le 2026-09-27) — la
             reprise fonctionne malgré tout (#491) mais autant l'éviter pour
             un gros import, plus simple que de devoir reprendre. -->
        <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))">
            Pour un gros import, pensez à désactiver la mise en veille de votre ordinateur pendant l'envoi.
        </p>
        <!-- #510 : le message rassurant existant (_describeUploadError,
             assets/controllers/takeout_import_controller.js) n'apparaît
             qu'après coup, une fois la coupure survenue — rien ne
             prévenait l'utilisateur à l'avance, avant de démarrer, que le
             travail déjà fait est conservé et qu'il suffit de
             resélectionner les mêmes fichiers pour reprendre. -->
        <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))">
            En cas de coupure de connexion, le travail déjà effectué est conservé : sélectionnez à nouveau les mêmes fichiers pour reprendre l'import là où il s'est arrêté.
        </p>
        <!-- #522 : pour limiter la charge sur le serveur en journée, le
             traitement d'un import peut être mis en pause et reprendre
             automatiquement la nuit suivante — sans cette mention,
             l'utilisateur pourrait croire à un blocage silencieux en voyant
             son import rester "en attente" plusieurs heures. -->
        <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))">
            Pour des raisons techniques (charge du serveur), le traitement de votre import peut être mis en pause et reprendra automatiquement la nuit suivante.
        </p>
    </div>

    <!-- #481 : imports interrompus (fermeture d'onglet) en attente de
         reprise ou d'abandon — vide par défaut, rempli en JS via
         GET /v1/takeout-imports/pending-list au chargement de la page. -->
    <ul class="flex flex-col gap-2" data-takeout-import-target="pendingList"></ul>

    <div class="settings-card flex flex-col gap-4" data-takeout-import-target="form">
        <label class="flex flex-col items-center justify-center gap-2 p-8 border-2 border-dashed rounded-xl cursor-pointer"
               style="border-color: var(--hc-border)"
               data-action="click->takeout-import#triggerFilePicker">
            <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--hc-text-secondary, var(--hc-text))">
                <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/>
                <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
            </svg>
            <span style="color: var(--hc-text)">Cliquez pour choisir un ou plusieurs fichiers ZIP</span>
            <input type="file" accept=".zip" multiple hidden
                   data-takeout-import-target="input"
                   data-action="change->takeout-import#onFilesSelected">
        </label>

        <ul class="flex flex-col gap-1 text-sm" style="color: var(--hc-text)" data-takeout-import-target="fileList"></ul>

        <button type="button" class="btn btn-primary self-end" disabled
                data-takeout-import-target="submit"
                data-action="click->takeout-import#submit">
            Démarrer l'import
        </button>

        <p class="text-sm" style="color: #f87171" hidden data-takeout-import-target="error"></p>
    </div>

    <div class="settings-card flex flex-col gap-3" hidden data-takeout-import-target="progress">
        <div class="takeout-progress-track" style="height: 8px; border-radius: 4px; overflow: hidden; background: var(--hc-border)">
            <div class="takeout-progress-bar" style="height: 100%; width: 0%; background: var(--hc-accent); transition: width 0.4s ease"
                 data-takeout-import-target="bar"></div>
        </div>
        <p class="font-medium" style="color: var(--hc-text)" data-takeout-import-target="status">En attente…</p>
        <p class="text-sm" style="color: var(--hc-text-secondary, var(--hc-text))" data-takeout-import-target="counts"></p>

        <!-- Progression du fichier en cours d'envoi (chunk par chunk) — un ZIP
             de plusieurs GB tient à lui seul plusieurs dizaines de chunks,
             la barre globale seule restait quasi figée pendant tout ce temps. -->
        <div hidden data-takeout-import-target="fileProgressWrapper" class="flex flex-col gap-1">
            <div class="takeout-progress-track" style="height: 4px; border-radius: 2px; overflow: hidden; background: var(--hc-border)">
                <div class="takeout-progress-bar" style="height: 100%; width: 0%; background: var(--hc-accent); opacity: 0.6; transition: width 0.2s ease"
                     data-takeout-import-target="fileBar"></div>
            </div>
            <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))" data-takeout-import-target="fileStatus"></p>
        </div>

        <!-- Message d'attente qui tourne pendant les longs transferts (#481) :
             un import Takeout peut prendre plusieurs minutes, un simple
             pourcentage qui avance lentement peut donner l'impression que
             l'interface est bloquée. -->
        <p class="text-xs takeout-patience-message" style="color: var(--hc-text-secondary, var(--hc-text))"
           data-takeout-import-target="patienceMessage"></p>

        <!-- #482 : une fois le traitement démarré côté serveur (extraction,
             parsing, import), contrairement à la phase d'upload (#481),
             fermer l'onglet est sans risque — le traitement continue en
             arrière-plan et reste consultable au retour sur la page. -->
        <p class="text-xs" style="color: var(--hc-text-secondary, var(--hc-text))" hidden
           data-takeout-import-target="safeToCloseMessage">
            Vous pouvez fermer cet onglet sans risque : l'import continue en arrière-plan.
            Revenez sur cette page à tout moment pour suivre sa progression.
        </p>
    </div>

</div>

{% endblock %}
